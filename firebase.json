{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,

    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "**/package.json",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/.env",
      "**/.env.*",
      "**/*secret*",
      "**/*private*",
      "**/*credential*",
      "**/*credentials*",
      "**/*serviceAccount*",
      "**/*service-account*",
      "**/*adminsdk*",
      "**/*.pem",
      "**/*.key",
      "**/*.crt",
      "**/*.p12",
      "**/*.pfx",
      "**/firebase-debug.log",
      "**/firebase-debug.*.log",
      "**/ui-debug.log"
    ],

    "headers": [
      {
        "source": "/hk-writers-access.html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/hk-writers-access",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
