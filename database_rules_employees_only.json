{
  "rules": {
    "posts": {
      ".read": true,
      ".indexOn": ["lang", "category", "createdAt"],
      "$postId": {
        ".write": "auth != null && root.child('employees').child(auth.uid).val() === true && !data.exists()",
        ".validate": "newData.hasChildren(['title','lang','category','content','date','createdAt','authorUid','authorEmail','status'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 130"
        },
        "lang": {
          ".validate": "newData.isString() && (newData.val() === 'ar' || newData.val() === 'en' || newData.val() === 'sv')"
        },
        "category": {
          ".validate": "newData.isString() && (newData.val() === 'Politics' || newData.val() === 'Economy' || newData.val() === 'Marketing' || newData.val() === 'Family')"
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "excerpt": {
          ".validate": "newData.isString() && newData.val().length <= 180"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length >= 40"
        },
        "date": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "authorUid": {
          ".validate": "newData.val() === auth.uid"
        },
        "authorEmail": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "status": {
          ".validate": "newData.val() === 'published'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "employees": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}